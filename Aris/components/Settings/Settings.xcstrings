    },
    "ElevenLabs Scribe로 듣기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen with ElevenLabs Scribe"
          }
        }
      }
    },
    "ElevenLabs 계정에 있는 목소리 중에서 골라요.": {
      "localizations": {
