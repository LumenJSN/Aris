      }
    },
    "Finder에서 보기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        }
      }
    },
    "GitHub 링크 붙여 넣기": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a GitHub link"
          }
        }
      }
    },
    "GitHub 링크만 받을 수 있어요 (https://github.com/…).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only GitHub links are taken (https://github.com/…)."
          }
        }
      }
    },
    "GitHub에서 받는 중": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting it from GitHub"
          }
        }
      }
    },
    "Gmail, Slack, Notion, Google 캘린더 등 여러 앱을 한 키로 연결해요. 읽기는 바로 하고, 보내거나 바꾸는 일은 매번 물어봐요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connects Gmail, Slack, Notion, Google Calendar and many more apps with one key. Reading happens at once; anything that sends or changes something asks every time."
          }
        }
      }
    },
    "Google 캘린더": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Calendar"
          }
        }
      }
    },
    "Google 캘린더로 열면 그날 보기가 웹에서 열려요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Calendar opens that day's view on the web."
          }
        }
      }
    },
    "LM Studio (이 Mac)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio (this Mac)"
          }
        }
      }
    },
    "MCP 서버": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP servers"
          }
        }
      }
    },
    "MCP 서버 바꾸기": {
      "localizations": {
        "en": {
