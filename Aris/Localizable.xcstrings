    "team.tpl.docs.how" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show a short draft first and ask what to change.\nUse a title and subheadings; keep paragraphs to three lines.\nAlways check with me before sending anything."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 초안을 짧게 보여 주고, 고칠 곳을 물어봐요.\n제목과 소제목을 달고, 한 문단은 세 줄을 넘기지 않아요.\n보내기 전에는 항상 확인받아요."
          }
        }
      }
    },
