<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Signed with the hardened runtime (it is unsandboxed code inside the app). It runs launchctl and sets the
	     screen's brightness; it sends no Apple event, so it has no entitlement for one (security review 4, L3). -->
</dict>
</plist>
